<UserControl
    x:Class="FormatFactoryWinUI.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FormatFactoryWinUI.Controls"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/PageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="PageRoot" x:FieldModifier="internal" Padding="{StaticResource FFPagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HistoryTitleText" x:FieldModifier="internal" Text="Conversion history" Style="{StaticResource FFPageTitleTextStyle}" />
        <InfoBar x:Name="HistoryInfoBar" x:FieldModifier="internal" Grid.Row="1" IsOpen="False" />
        <AutoSuggestBox x:Name="HistorySearchBox" x:FieldModifier="internal"
                        Grid.Row="2" AutomationProperties.Name="Search conversion history"
                        PlaceholderText="Search file name, format or path"
                        TextChanged="HistorySearchBox_TextChanged">
            <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>
        <Grid Grid.Row="3">
            <TextBlock x:Name="HistoryEmptyText" x:FieldModifier="internal"
                       Text="No conversion history"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="HistoryList" x:FieldModifier="internal" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None"
                      Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Conversion history">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border controls:CardInteraction.Enable="True" Style="{StaticResource FFCardStyle}"
                                Tag="{Binding}" Loaded="HistoryCard_Loaded" DataContextChanged="HistoryCard_DataContextChanged">
                            <Border.ContextFlyout>
                                <MenuFlyout Opening="HistoryCardActions_Opening" MenuFlyoutPresenterStyle="{StaticResource FFMenuFlyoutPresenterStyle}" />
                            </Border.ContextFlyout>
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OutputPath}" Style="{StaticResource FFSecondaryTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding OutputPath}" />
                                    <TextBlock x:Name="HistoryDetailsText" Style="{StaticResource FFSecondaryTextStyle}" />
                                    <TextBlock x:Name="HistoryResultSummaryText" Style="{StaticResource FFSecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Name="RepeatHistoryButton" Tag="{Binding}" Click="RepeatHistoryTaskButton_Click"
                                            MinHeight="36" VerticalAlignment="Center"
                                            AutomationProperties.Name="Add again to queue" Content="Add again to queue" />
                                    <Button x:Name="OpenHistoryFileButton" Tag="{Binding OutputPath}" Click="OpenHistoryFileButton_Click"
                                            Width="36" Height="36" Padding="0" VerticalAlignment="Center"
                                            AutomationProperties.Name="Open file" ToolTipService.ToolTip="Open file">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="OpenHistoryLocationButton" Tag="{Binding OutputPath}" Click="OpenHistoryOutputButton_Click"
                                            Width="36" Height="36" Padding="0" VerticalAlignment="Center"
                                            AutomationProperties.Name="Open output location" ToolTipService.ToolTip="Open output location">
                                        <FontIcon Glyph="&#xE838;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
