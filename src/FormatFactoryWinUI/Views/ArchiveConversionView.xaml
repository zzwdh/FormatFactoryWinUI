<UserControl
    x:Class="FormatFactoryWinUI.Views.ArchiveConversionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/PageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource FFCardStyle}">
        <StackPanel Spacing="12">
            <TextBlock x:Name="TitleText" Style="{StaticResource FFSectionTitleTextStyle}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource FFSecondaryTextStyle}" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputFolderBox" x:FieldModifier="internal" TextChanged="OutputFolder_Changed" />
                <Button x:Name="BrowseButton" Grid.Column="1" VerticalAlignment="Bottom" Click="Browse_Click" />
            </Grid>
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="145" ItemHeight="44" MaximumRowsOrColumns="4">
                <Button x:Name="AddButton" Click="Add_Click" Style="{StaticResource LayoutTextButtonStyle}" />
                <Button x:Name="BatchSettingsButton" Click="BatchSettings_Click" Style="{StaticResource LayoutTextButtonStyle}" />
                <Button x:Name="StartButton" Click="Start_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                <Button x:Name="CancelButton" Click="Cancel_Click" Style="{StaticResource LayoutTextButtonStyle}" />
                <Button x:Name="ClearButton" Click="Clear_Click" Style="{StaticResource LayoutTextButtonStyle}" />
            </VariableSizedWrapGrid>
            <TextBlock x:Name="VolumeHintText" Style="{StaticResource FFSecondaryTextStyle}" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="BatchResultText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource FFSecondaryTextStyle}" />
            <ListView x:Name="TaskList" x:FieldModifier="internal" SelectionMode="None" MaxHeight="520"
                      HorizontalContentAlignment="Stretch" Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="6" HorizontalAlignment="Stretch" Background="Transparent">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout Opening="ArchiveTaskActions_Opening" MenuFlyoutPresenterStyle="{StaticResource FFMenuFlyoutPresenterStyle}">
                                    <MenuFlyoutItem Text="{Binding SettingsLabel}" Tag="{Binding}" IsEnabled="{Binding CanEdit}" Click="TaskSettings_Click">
                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="{Binding RetryLabel}" Tag="{Binding}" IsEnabled="{Binding CanRetry}" Click="Retry_Click">
                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="{Binding ChooseOutputFolderLabel}" Tag="{Binding}" Click="ChooseTaskOutput_Click"
                                                    Visibility="{Binding CanChooseOutputFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="{Binding OpenLabel}" Tag="{Binding}" IsEnabled="{Binding CanOpen}" Click="OpenOutput_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="{Binding RemoveLabel}" Tag="{Binding}" Click="Remove_Click">
                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Cancel" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding SourcePath}" />
                            <TextBlock Text="{Binding SettingsSummary}" Style="{StaticResource FFSecondaryTextStyle}" />
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="4" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PreviousFailure}" Style="{StaticResource FFSecondaryTextStyle}"
                                       Visibility="{Binding HasPreviousFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource FFSecondaryTextStyle}"
                                       Visibility="{Binding HasResultSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource FFSecondaryTextStyle}"
                                       Visibility="{Binding HasHistoryStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding OutputPath}" Style="{StaticResource FFSecondaryTextStyle}"
                                       Visibility="{Binding HasOutputPath, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding OutputPath}" />
                            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="145" ItemHeight="40" MaximumRowsOrColumns="4">
                                <Button Content="{Binding SettingsLabel}" Tag="{Binding}" IsEnabled="{Binding CanEdit}"
                                        Click="TaskSettings_Click" Style="{StaticResource LayoutTextButtonStyle}" />
                                <Button Content="{Binding RetryLabel}" Tag="{Binding}" IsEnabled="{Binding CanRetry}"
                                        Click="Retry_Click" Style="{StaticResource LayoutTextButtonStyle}" />
                                <Button Content="{Binding ChooseOutputFolderLabel}" Tag="{Binding}"
                                        Visibility="{Binding CanChooseOutputFolder, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="ChooseTaskOutput_Click" Style="{StaticResource LayoutTextButtonStyle}" />
                                <Button Content="{Binding RemoveLabel}" Tag="{Binding}"
                                        Click="Remove_Click" Style="{StaticResource LayoutTextButtonStyle}" />
                                <Button Content="{Binding OpenLabel}" Tag="{Binding}" IsEnabled="{Binding CanOpen}"
                                        Click="OpenOutput_Click" Style="{StaticResource LayoutTextButtonStyle}" />
                            </VariableSizedWrapGrid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
