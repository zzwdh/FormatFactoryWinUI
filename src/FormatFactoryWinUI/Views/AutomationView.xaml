<UserControl
    x:Class="FormatFactoryWinUI.Views.AutomationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/PageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="PageRoot" Padding="{StaticResource FFPagePadding}" RowSpacing="12" SizeChanged="PageRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource FFPageTitleTextStyle}" />
        <TextBlock x:Name="DescriptionText" Grid.Row="1" Style="{StaticResource FFSecondaryTextStyle}" />
        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Polite" />
        <Grid x:Name="ContentGrid" Grid.Row="3" ColumnSpacing="18" RowSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="300" />
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ListRow" Height="*" />
                <RowDefinition x:Name="EditorRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid x:Name="RulesPane" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NewButton" Click="NewButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                    <Button x:Name="UpButton" Grid.Column="1" Click="UpButton_Click"><FontIcon Glyph="&#xE74A;" /></Button>
                    <Button x:Name="DownButton" Grid.Column="2" Click="DownButton_Click"><FontIcon Glyph="&#xE74B;" /></Button>
                </Grid>
                <TextBlock x:Name="PriorityHint" Grid.Row="1" Style="{StaticResource FFSecondaryTextStyle}" />
                <Grid Grid.Row="2">
                    <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="12" />
                    <ListView x:Name="RulesList" SelectionMode="Single" SelectionChanged="RulesList_SelectionChanged" HorizontalContentAlignment="Stretch" />
                </Grid>
            </Grid>
            <ScrollViewer x:Name="EditorPane" Grid.Column="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EditorFields" Spacing="14">
                    <TextBox x:Name="NameBox" MaxLength="160" />
                    <CheckBox x:Name="EnabledBox" />
                    <Border Style="{StaticResource FFCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="TriggerTitle" Style="{StaticResource FFSectionTitleTextStyle}" />
                            <TextBox x:Name="FolderBox" LostFocus="FolderBox_LostFocus" />
                            <Button x:Name="FolderBrowseButton" Tag="input" Click="BrowseFolder_Click" />
                            <CheckBox x:Name="SubfoldersBox" />
                            <CheckBox x:Name="WatchBox" />
                            <CheckBox x:Name="CatchUpBox" />
                            <TextBlock x:Name="CatchUpHint" Style="{StaticResource FFSecondaryTextStyle}" />
                            <CheckBox x:Name="ScheduleBox" Checked="ScheduleBox_Changed" Unchecked="ScheduleBox_Changed" />
                            <TimePicker x:Name="SchedulePicker" ClockIdentifier="24HourClock" MinuteIncrement="1" HorizontalAlignment="Stretch" />
                            <NumberBox x:Name="RetryCountBox" Minimum="0" Maximum="5" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="RetryCountBox_ValueChanged" />
                            <NumberBox x:Name="RetryDelayBox" Minimum="1" Maximum="3600" SmallChange="1" SpinButtonPlacementMode="Compact" />
                            <TextBlock x:Name="RetryHint" Style="{StaticResource FFSecondaryTextStyle}" />
                            <TextBlock x:Name="ManualHint" Style="{StaticResource FFSecondaryTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FFCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="FiltersTitle" Style="{StaticResource FFSectionTitleTextStyle}" />
                            <ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" SelectionChanged="KindBox_SelectionChanged" />
                            <TextBox x:Name="ExtensionsBox" />
                            <TextBlock x:Name="ExtensionsHint" Style="{StaticResource FFSecondaryTextStyle}" />
                            <TextBox x:Name="PatternBox" />
                            <TextBlock x:Name="PatternHint" Style="{StaticResource FFSecondaryTextStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FFCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="ConversionTitle" Style="{StaticResource FFSectionTitleTextStyle}" />
                            <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch" SelectionChanged="PresetBox_SelectionChanged" />
                            <Expander x:Name="PresetSaveExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <TextBox x:Name="PresetNameBox" MaxLength="128" />
                                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="180" ItemHeight="44" MaximumRowsOrColumns="2">
                                        <Button x:Name="SavePresetButton" Click="SavePresetButton_Click" HorizontalAlignment="Stretch" Margin="0,0,8,4" />
                                        <Button x:Name="DeletePresetButton" Click="DeletePresetButton_Click" HorizontalAlignment="Stretch" Margin="0,0,8,4" />
                                    </VariableSizedWrapGrid>
                                </StackPanel>
                            </Expander>
                            <ComboBox x:Name="TargetBox" HorizontalAlignment="Stretch" SelectionChanged="TargetBox_SelectionChanged" />
                            <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectionChanged="ModeBox_SelectionChanged" />
                            <Button x:Name="OutputsButton" Click="OutputsButton_Click" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="OutputsSummary" Style="{StaticResource FFSecondaryTextStyle}" />
                            <Expander x:Name="AdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="AdvancedHint" Style="{StaticResource FFSecondaryTextStyle}" />
                                    <TextBox x:Name="OcrLanguageBox" MaxLength="63" />
                                    <ComboBox x:Name="LayoutBox" HorizontalAlignment="Stretch" />
                                    <ComboBox x:Name="ImageColorBox" HorizontalAlignment="Stretch" />
                                    <CheckBox x:Name="RepairDocxBox" IsThreeState="True" />
                                    <CheckBox x:Name="CompatibleAudioBox" />
                                    <TextBox x:Name="OutputTemplateBox" MaxLength="160" />
                                    <TextBlock x:Name="OutputTemplateHint" Style="{StaticResource FFSecondaryTextStyle}" />
                                    <CheckBox x:Name="PreserveFoldersBox" IsThreeState="True" />
                                </StackPanel>
                            </Expander>
                            <TextBox x:Name="OutputBox" />
                            <Button x:Name="OutputBrowseButton" Tag="output" Click="BrowseFolder_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FFCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SourceTitle" Style="{StaticResource FFSectionTitleTextStyle}" />
                            <CheckBox x:Name="ArchiveBox" Checked="ArchiveBox_Changed" Unchecked="ArchiveBox_Changed" />
                            <TextBox x:Name="ArchiveFolderBox" />
                            <Button x:Name="ArchiveBrowseButton" Tag="archive" Click="BrowseFolder_Click" />
                            <TextBlock x:Name="ArchiveHint" Style="{StaticResource FFSecondaryTextStyle}" />
                        </StackPanel>
                    </Border>
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="150" ItemHeight="48" MaximumRowsOrColumns="3">
                        <Button x:Name="SaveButton" Click="SaveButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,8,4" />
                        <Button x:Name="PreviewButton" Click="PreviewButton_Click" Style="{StaticResource LayoutTextButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,8,4" />
                        <Button x:Name="RunButton" Click="RunButton_Click" Style="{StaticResource LayoutTextButtonStyle}" Margin="0,0,8,4" />
                        <Button x:Name="DeleteButton" Click="DeleteButton_Click" Style="{StaticResource LayoutTextButtonStyle}" Margin="0,0,8,4" />
                    </VariableSizedWrapGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
