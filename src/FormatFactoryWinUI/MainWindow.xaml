<Window
    x:Class="FormatFactoryWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FormatFactoryWinUI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FluentFormatConverter">

    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar">
            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ToggleButton x:Name="NavigationToggleButton" Width="40" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Click="NavigationToggleButton_Click">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
            </ToggleButton>
            <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
                    <Image Source="ms-appx:///Assets/AppIcon44.png" Width="20" Height="20" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="AppTitleText" Text="FluentFormatConverter" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Grid>
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left" IsPaneOpen="True"
                        OpenPaneLength="80" CompactPaneLength="80"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <!-- Custom content owns the icon. Reclaim the native empty icon slot
                     (8) and trailing content inset (14) in the presenter itself. -->
                <Thickness x:Key="NavigationViewItemContentPresenterMargin">-8,0,-14,0</Thickness>
                <Thickness x:Key="NavigationViewItemMargin">4,2,4,2</Thickness>
                <Thickness x:Key="NavigationViewItemButtonMargin">0</Thickness>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavAllItem" Content="All tasks" Tag="all" IsSelected="True">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavVideoItem" Content="Video" Tag="video">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Video" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAudioItem" Content="Audio" Tag="audio">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Audio" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavImageItem" Content="Images" Tag="image">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDocumentItem" Content="Documents" Tag="document">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Page" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavEbookItem" Content="Ebooks" Tag="ebook">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDiscItem" Content="Discs and images" Tag="disc">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE958;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavArchiveItem" Content="Archive conversion" Tag="archive">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF012;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavAutomationItem" Tag="automation">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="NavHistoryItem" Content="History" Tag="history">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettingsItem" Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar x:Name="ImportStatusBar" IsOpen="False" IsClosable="False"
                             Severity="Informational" AutomationProperties.LiveSetting="Polite">
                        <InfoBar.ActionButton>
                            <Button x:Name="CancelImportButton" Click="CancelImportButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <views:QueueView x:Name="ConverterView" Grid.Row="1" />
                    <views:HistoryView x:Name="HistoryView" Grid.Row="1" Visibility="Collapsed" />
                    <views:SettingsView x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" />
                    <ScrollViewer x:Name="ArchivePage" Grid.Row="1" Visibility="Collapsed" Padding="24,20"
                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <views:ArchiveConversionView x:Name="ArchiveView" />
                    </ScrollViewer>
                    <views:AutomationView x:Name="AutomationView" Grid.Row="1" Visibility="Collapsed" IsEnabled="False" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <!-- Feedback stays fixed over the viewport and never intercepts drag events. -->
        <Border x:Name="DropFeedbackOverlay"
                Grid.RowSpan="2"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="14"
                Margin="8"
                Padding="16">
            <Border x:Name="DropFeedbackCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,18"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <FontIcon Glyph="&#xE898;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DropFeedbackText"
                               Text="Release to add to the conversion queue"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
