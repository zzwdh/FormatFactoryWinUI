<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>FormatFactoryWinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>260824</Version>
    <AssemblyVersion>26.8.24.0</AssemblyVersion>
    <FileVersion>26.8.24.0</FileVersion>
    <InformationalVersion>260824</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon44.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon150.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyWinUiCompiledResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUiCompiledResource Include="$(TargetDir)App.xbf" />
      <_WinUiCompiledResource Include="$(TargetDir)MainWindow.xbf" />
      <_WinUiCompiledResource Include="$(TargetDir)FormatFactoryWinUI.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUiCompiledResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Assets" />
    <Copy SourceFiles="$(TargetDir)Assets\AppIconSource.png" DestinationFolder="$(PublishDir)Assets" SkipUnchangedFiles="true" />
  </Target>
</Project>
