<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ReleaseVersionFile>$(MSBuildThisFileDirectory)VERSION</ReleaseVersionFile>
    <ReleaseVersion>$([System.IO.File]::ReadAllText('$(ReleaseVersionFile)').Trim())</ReleaseVersion>
    <Version>$(ReleaseVersion)</Version>
    <AssemblyVersion>$(ReleaseVersion)</AssemblyVersion>
    <FileVersion>$(ReleaseVersion)</FileVersion>
    <InformationalVersion>$(ReleaseVersion)</InformationalVersion>
    <MinimumDesktopWindowsVersion>10.0.19045.0</MinimumDesktopWindowsVersion>
  </PropertyGroup>

  <!-- A release restore passes Platform to all project references. Give shared
       projects the matching RID before NuGet evaluates their lock path. -->
  <PropertyGroup Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'arm64'">
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform)</RuntimeIdentifier>
  </PropertyGroup>

  <Target Name="ValidateReleaseVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ReleaseVersion)' == ''" Text="VERSION must contain a four-part release version." />
  </Target>
</Project>
