<Project>
  <!-- Restore can evaluate project references with a RID even when they normally
       build without one. Keep those graphs separate from the ordinary lock. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)\packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
